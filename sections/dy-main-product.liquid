{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign net_price = current_variant.price | divided_by: 1.2 | round -%}
{%- assign is_custom_paint = false -%}
{%- if product.tags contains 'mischlack' -%}
  {%- assign is_custom_paint = true -%}
{%- endif -%}

<div class="main-container">
  <div style="margin-bottom: 14px; font-size: 13px;">
    <a href="/collections/all" style="color:var(--text-muted); text-decoration:underline;">&larr; Zurück zum Sortiment</a>
  </div>

  <div class="detail-layout">
    <!-- LEFT COLUMN: PRODUCT VISUAL OR CONDITIONAL VEHICLE SILHOUETTE -->
    <div>
      <div class="panel-box" style="background:#fff;">
        <div class="panel-label">PRODUKTANSICHT / FARBVORSCHAU</div>

        <!-- Default Neutral Stage (No car model unless VIN/model is active) -->
        <div id="dy-neutral-stage" style="background:var(--bg-grey); border:1px solid var(--border-color); height:240px; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:16px; text-align:center;">
          {%- if product.featured_media -%}
            <img src="{{ product.featured_media | image_url: width: 420 }}" alt="{{ product.title | escape }}" style="max-height:135px; width:auto; object-fit:contain; margin-bottom:10px;">
          {%- else -%}
            <div id="dy-neutral-swatch" style="width:76px; height:76px; border-radius:4px; background:#14171a; border:2px solid rgba(0,0,0,0.25); margin-bottom:10px;"></div>
          {%- endif -%}
          <strong style="font-size:14.5px;">{{ product.title }}</strong>

          {%- if is_custom_paint -%}
            <button type="button" onclick="document.getElementById('dy-neutral-stage').style.display='none'; document.getElementById('dy-vehicle-stage').style.display='block';" style="margin-top:10px; font-size:12px; padding:5px 10px; border:1px solid #b6bcc6; background:#fff; cursor:pointer; border-radius:2px;">
              Beispiel-Fahrzeugmodell einblenden
            </button>
          {%- endif -%}
        </div>

        <!-- Vehicle Stage (Auto-activated via VIN search or manual toggle) -->
        <div id="dy-vehicle-stage" style="display:none; background:radial-gradient(circle, #fff 0%, #e5e7eb 100%); border:1px solid var(--border-color); height:240px; padding:16px; text-align:center;">
          <div style="font-size:12px; font-weight:800; color:var(--status-green); margin-bottom:8px;" id="dy-detected-model-banner">
            Beispiel-Fahrzeugvorschau
          </div>
          <svg viewBox="0 0 600 190" style="width:100%; max-width:380px;">
            <ellipse cx="300" cy="168" rx="235" ry="10" fill="rgba(0,0,0,0.18)"/>
            <path id="dy-svg-car-body" fill="#14171a" d="M 50 130 L 65 95 L 160 85 L 230 42 L 410 42 L 490 85 L 545 98 L 550 144 L 520 158 L 80 158 L 50 144 Z"/>
            <path fill="#ffffff" opacity="0.22" d="M 50 130 L 65 95 L 160 85 L 230 42 L 410 42 L 490 85 L 545 98 Z"/>
            <path fill="#1f2933" d="M 238 50 L 402 50 L 472 84 L 178 84 Z"/>
            <circle cx="150" cy="154" r="27" fill="#1b1d22"/><circle cx="150" cy="154" r="16" fill="#c5cad3"/>
            <circle cx="450" cy="154" r="27" fill="#1b1d22"/><circle cx="450" cy="154" r="16" fill="#c5cad3"/>
          </svg>
          <div>
            <button type="button" onclick="document.getElementById('dy-vehicle-stage').style.display='none'; document.getElementById('dy-neutral-stage').style.display='flex';" style="font-size:11.5px; color:var(--text-muted); background:none; border:none; text-decoration:underline; cursor:pointer; margin-top:6px;">
              Zurück zur Standardansicht
            </button>
          </div>
        </div>
      </div>

      {%- if product.description != blank -%}
        <div class="panel-box" style="background:#fff;">
          <div class="panel-label">PRODUKTBESCHREIBUNG &amp; HINWEISE</div>
          <div style="font-size:13.5px; color:#2b2f36; line-height:1.5;">
            {{ product.description }}
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- RIGHT COLUMN: STRUCTURED PURCHASE BOXES -->
    <div>
      <!-- Box 1: Price, Net Price & Unit Price -->
      <div class="panel-box">
        <div style="font-size:11.5px; color:var(--text-muted); margin-bottom:4px;">
          Art.-Nr.: <span id="dy-variant-sku">{{ current_variant.sku | default: '—' }}</span> | Marke: {{ product.vendor }}
        </div>
        <h1 style="font-size: 19px; font-weight: 900; margin-bottom: 8px;">{{ product.title }}</h1>
        <div style="font-size: 30px; font-weight: 900; color: var(--brand-orange); line-height: 1.05;" id="dy-price-gross">
          {{ current_variant.price | money }}
        </div>
        <div style="font-size: 12.5px; color: var(--text-muted); margin-top: 4px;" id="dy-price-net">
          Preis exkl. MwSt.: {{ net_price | money }}
          {%- if current_variant.unit_price_measurement -%}
            &nbsp;| [Grundpreis: {{ current_variant.unit_price | money }} / {% if current_variant.unit_price_measurement.reference_value != 1 %}{{ current_variant.unit_price_measurement.reference_value }}{% endif %}{{ current_variant.unit_price_measurement.reference_unit }}]
          {%- endif -%}
        </div>
        <div style="font-size: 13px; font-weight: 700; color: var(--status-green); margin-top: 10px;">
          ● Sofort verfügbar – Abholung in 1110 Wien / 2201 Hagenbrunn oder Versand
        </div>
      </div>

      <!-- Native Shopify Product Form -->
      {%- form 'product', product, id: 'dy-product-form' -%}
        <input type="hidden" name="id" id="dy-variant-id" value="{{ current_variant.id }}">

        {%- if is_custom_paint -%}
          <!-- Box 2A: Farbcode & FIN Inputs (saved as Shopify Line Item Properties) -->
          <div class="panel-box">
            <div class="panel-label">1. WUNSCHFARBCODE ODER FIN ANGEBEN</div>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px;">
              <div>
                <label for="dy-prop-colorcode" style="font-size:11.5px; font-weight:700; display:block; margin-bottom:3px;">Farbcode (z.B. 197, LC9X)</label>
                <input type="text" id="dy-prop-colorcode" name="properties[Farbcode]" placeholder="Farbcode..." style="width:100%; height:38px; border:1px solid #b6bcc6; padding:0 10px; font-weight:700; background:#fff;">
              </div>
              <div>
                <label for="dy-prop-vin" style="font-size:11.5px; font-weight:700; display:block; margin-bottom:3px;">Optional: FIN (17-stellig)</label>
                <input type="text" id="dy-prop-vin" name="properties[FIN]" maxlength="17" placeholder="WDD205..." style="width:100%; height:38px; border:1px solid #b6bcc6; padding:0 10px; font-family:monospace; background:#fff;">
              </div>
            </div>
            <div style="margin-top:8px; font-size:12px;">
              <a href="https://wa.me/436644456359?text={{ 'Hallo DY Autocolor Team, könnt ihr mir helfen meinen Farbcode am Typenschild abzulesen?' | url_encode }}" target="_blank" rel="noopener" style="color:var(--status-green); font-weight:700; text-decoration:underline;">
                💬 Farbcode nicht gefunden? Schicken Sie uns kurz ein Foto vom Typenschild per WhatsApp!
              </a>
            </div>
          </div>
        {%- endif -%}

        {%- if product.variants.size > 1 -%}
          <!-- Box 2B: Variant / Tier Grid (e.g. 1=25€, 2=45€, 3=60€, 4=75€) -->
          <div class="panel-box">
            <div class="panel-label">MENGENSTAFFEL / GEBINDE WÄHLEN</div>
            <div class="tier-grid">
              {%- for variant in product.variants -%}
                {%- assign v_net = variant.price | divided_by: 1.2 | round -%}
                {%- capture v_unit -%}
                  {%- if variant.unit_price_measurement -%}
                    Grundpreis: {{ variant.unit_price | money }} / {% if variant.unit_price_measurement.reference_value != 1 %}{{ variant.unit_price_measurement.reference_value }}{% endif %}{{ variant.unit_price_measurement.reference_unit }}
                  {%- endif -%}
                {%- endcapture -%}
                <button
                  type="button"
                  class="tier-btn {% if variant == current_variant %}active{% endif %}"
                  data-variant-id="{{ variant.id }}"
                  data-price="{{ variant.price | money }}"
                  data-net-price="{{ v_net | money }}"
                  data-unit-info="{{ v_unit | strip }}"
                  data-sku="{{ variant.sku | default: '—' }}"
                  onclick="selectDyVariant(this)"
                >
                  <strong>{{ variant.title }}</strong><br>
                  <span style="color:var(--status-green); font-weight:700;">{{ variant.price | money }}</span>
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <!-- Box 3: Quantity & Submit -->
        <div class="panel-box" style="background:#fff; border:2px solid var(--border-color);">
          <div class="panel-label">MENGE &amp; BESTELLUNG</div>
          <div style="display:flex; gap:10px; align-items:center; margin-bottom:10px;">
            <input type="number" name="quantity" value="1" min="1" style="width:72px; height:44px; text-align:center; font-size:16px; font-weight:800; border:1px solid #b6bcc6;">
            <button type="submit" class="btn-orange-full" style="height:44px; font-size:15px; text-transform:uppercase;">
              In den Warenkorb
            </button>
          </div>
          <div style="font-size:12px; color:var(--text-muted);">
            ✓ Versand innerhalb Österreichs ab 100 € kostenlos &nbsp;|&nbsp; ✓ Direkte Mitnahme im Geschäft möglich
          </div>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "DY Produktseite",
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "DY Produktseite"
    }
  ]
}
{% endschema %}
